<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:BingWallE.Controls">
    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.coffee">
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="{Binding $parent[Button].(ui:ButtonIcons.Icon)}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"
                               Foreground="{ReflectionBinding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </DataTemplate>
        </Setter>
    </Style>
</Styles>
