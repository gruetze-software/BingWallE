<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.6.4</Version>
    <AssemblyName>bingwalle</AssemblyName>


    <Authors>Grütze-Software</Authors>
    <Product>BingWallE</Product>
    <AssemblyTitle>BingWallE — Bing Wallpaper Collector</AssemblyTitle>
    <Company>Grütze-Software</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <ApplicationIcon>Assets/bingwalle.ico</ApplicationIcon>
    <Description>Browse and collect Bing wallpapers in HD, Full HD and UHD.</Description>
    <Copyright>Copyright © 2026 Grütze-Software</Copyright>
    <Maintainer>schaefer.christoph@posteo.de</Maintainer>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>bingwalle</PackageId>
    <PackageProjectUrl>https://github.com/gruetze-software/BingWallE</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gruetze-software/BingWallE.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>



  <ItemGroup>

    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Localization/strings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="ExifLibNet" Version="2.1.4" />

  </ItemGroup>
  <!-- Filter dependency symbols and link-time files before single-file bundling
       as well as ordinary publishing. Debug builds retain their symbols. -->
  <Target Name="RemoveReleasePackagingArtifacts"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' Or
                   '%(ResolvedFileToPublish.Extension)' == '.dbg' Or
                   '%(ResolvedFileToPublish.Extension)' == '.debug' Or
                   '%(ResolvedFileToPublish.Extension)' == '.dwarf' Or
                   '%(ResolvedFileToPublish.Extension)' == '.mdb' Or
                   '%(ResolvedFileToPublish.Extension)' == '.lib' Or
                   '%(ResolvedFileToPublish.Extension)' == '.exp' Or
                   '%(ResolvedFileToPublish.Extension)' == '.a' Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('.dSYM/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('.dSYM\'))" />
    </ItemGroup>
  </Target>
</Project>
