<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:BingWallE.Controls"
        x:Class="BingWallE.Views.AboutWindow"
        Icon="/Assets/bingwalle.ico" Title="{DynamicResource Text049}"
        Background="{DynamicResource AboutBackground}" Width="600" Height="660" CanResize="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="AboutBackground" Color="#F4F6F7"/></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="AboutBackground" Color="#151C21"/></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid RowDefinitions="*,Auto" Margin="28">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="22,0,22,4">
                <Image Source="/Assets/bingwalle-logo.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="96" Height="96" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ProductName" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Text047}" FontSize="15" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Text071}"
                           TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" Margin="8,0"/>
                <Separator Margin="0,6"/>
                <Grid ColumnDefinitions="100,*" Margin="12,0">
                    <Image Source="/Assets/gruetze-software.png" Width="88" Height="88"/>
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Text072}" FontSize="12" Opacity="0.7"/>
                        <TextBlock Text="Grütze-Software" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="© 2026 Grütze-Software" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6">
                    <Button Content="{DynamicResource Text073}" Tag="https://github.com/gruetze-software/BingWallE" Click="OpenLink"/>
                    <Button Content="Grütze-Software" Tag="https://github.com/gruetze-software" Click="OpenLink"/>
                </StackPanel>
                <Separator/>
                <TextBlock Text="{DynamicResource SupportHelp}" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Classes="coffee" Content="{DynamicResource SupportKofi}" Tag="https://ko-fi.com/gruetzesoftware" Click="OpenLink" HorizontalAlignment="Center" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Coffee}"/>
                <Separator/>
                <TextBlock Text="C# · .NET 10 · Avalonia   |   Windows · Linux · macOS" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Text074}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.7"/>
                <TextBlock x:Name="LinkStatus" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="{DynamicResource Text068}" IsDefault="True" IsCancel="True" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinWidth="120" Margin="0,16,0,0" Click="CloseDialog"/>
    </Grid>
</Window>
