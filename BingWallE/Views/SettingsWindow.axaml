<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BingWallE.ViewModels"
        xmlns:models="using:BingWallE.Models"
        x:Class="BingWallE.Views.SettingsWindow" x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource SettingsTitle}" Icon="/Assets/bingwalle.ico"
        Width="540" Height="740" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SettingsBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsBackground" Color="#F4F6F7"/>
                    <SolidColorBrush x:Key="SettingsCard" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SettingsBackground" Color="#151C21"/>
                    <SolidColorBrush x:Key="SettingsCard" Color="#202A30"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
        <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="12"/><Setter Property="Opacity" Value="0.7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style Selector="ComboBox">
            <Setter Property="ItemTemplate"><DataTemplate x:DataType="models:SelectionOption"><TextBlock Text="{Binding Label}"/></DataTemplate></Setter>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="28">
        <StackPanel Spacing="8" Margin="0,0,22,20">
            <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource SettingsHelp}" Classes="hint"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18">
                <CheckBox Content="{DynamicResource AutoRefreshOnStartup}" IsChecked="{Binding AutoRefreshOnStartup}"/>
                <StackPanel Spacing="7">
                    <TextBlock Text="{DynamicResource AppLanguage}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{DynamicResource AppLanguage}"/>
                </StackPanel>
                <Border Background="{DynamicResource SettingsCard}" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="9">
                        <TextBlock Text="{DynamicResource DownloadLanguage}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket}" AutomationProperties.Name="{DynamicResource DownloadLanguage}"/>
                        <TextBlock Text="{DynamicResource DownloadLanguageHelp}" Classes="hint"/>
                        <TextBlock Text="{DynamicResource RegionRefreshHelp}" Classes="hint"/>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="7">
                    <TextBlock Text="{DynamicResource Text055}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" AutomationProperties.Name="{DynamicResource Text055}"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <CheckBox Content="{DynamicResource AutoTags}" IsChecked="{Binding AutoTags}"/>
                    <TextBlock Text="{DynamicResource AutoTagsHelp}" Classes="hint"/>
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Text="{DynamicResource Text050}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{DynamicResource Text051}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{DynamicResource Done}" Click="CloseDialog" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="110" Padding="18,9" Margin="0,20,0,0" CornerRadius="7"
                Background="#216F69" Foreground="White"/>
    </Grid>
</Window>
